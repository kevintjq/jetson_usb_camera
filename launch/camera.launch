<launch>
    <!-- Set these manually to a combination supported by your camera. -->
    <arg name="device" default="/dev/video0"/>
    <arg name="width" default="1920"/>
    <arg name="height" default="1080"/>
    <arg name="framerate" default="60"/>
    <arg name="framerate_denominator" default="1"/>
    <arg name="output_encoding" default="bgr8"/>

    <node pkg="jetson_gst_camera" type="jetson_gst_camera_node"
          name="jetson_gst_camera" output="screen">
        <param name="device" value="$(arg device)" type="str"/>
        <param name="width" value="$(arg width)" type="int"/>
        <param name="height" value="$(arg height)" type="int"/>
        <param name="framerate" value="$(arg framerate)" type="int"/>
        <param name="framerate_denominator" value="$(arg framerate_denominator)" type="int"/>
        <param name="output_encoding" value="$(arg output_encoding)" type="str"/>
        <param name="frame_id" value="camera"/>
        <param name="image_topic" value="/camera/image_raw"/>
        <param name="camera_name" value="camera"/>
        <param name="camera_info_topic" value="/camera/camera_info"/>

        <!-- Enable only after replacing the existing template with real calibration.
        <param name="camera_info_url"
               value="file://$(find jetson_gst_camera)/config/camera_info.yaml"/>
        -->
        <param name="reconnect_interval" value="2.0"/>
        <param name="frame_timeout" value="3.0"/>
        <param name="max_frame_age" value="0.5"/>
    </node>
</launch>
